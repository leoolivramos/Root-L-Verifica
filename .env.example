# ==============================================================================
# Provedor LLM: OpenAI oficial
# ==============================================================================
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-sua-chave-aqui
LLM_MODEL=gpt-4o-mini
LLM_CONTEXT_TOKENS=128000
LLM_TIMEOUT_S=60

# ==============================================================================
# Alternativa: Ollama (Execução local)
# ==============================================================================
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_CONTEXT_TOKENS=8192
# LLM_TIMEOUT_S=120

# Busca: auto | duckduckgo | tavily  (auto = Tavily se houver chave, senão DuckDuckGo)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

DB_PATH=data/reliability.db
OUTDATED_AFTER_DAYS=365

# Modo demonstração (LLM e busca falsos, determinísticos) — apenas para testar a UI
RELIABILITY_DEMO=0
